# All of these are server-only. Never prefix secrets with NEXT_PUBLIC_.
STORE_URL=http://localhost:3000
CHECKOUT_ENABLED=false
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHECKOUT_SIGNING_SECRET=
# Enable the Google Geocoding API and restrict this server key to that API.
GOOGLE_MAPS_API_KEY=
# Explicitly set your applicable percentage. Use 0 only if your goods are exempt.
STORE_TAX_PERCENT=
# Explicitly choose true or false according to your delivery tax treatment.
DELIVERY_FEE_TAXABLE=
# local uses the existing 12 products and prices in src/lib/products.ts.
# square uses an explicit item allowlist from the connected Square Item Library.
CATALOG_SOURCE=local
SQUARE_STOREFRONT_ITEM_IDS=
